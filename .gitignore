node_modules/
dist/
test-results/
playwright-report/
*.log
.vite/
*.tsbuildinfo

# Pipeline personnage : dossier de travail complet en local, seuls les
# formats texte (scripts, docs, rapports) sont versionnés. Tout autre format
# (GLB, .blend, OBJ, images, vidéo, ZIP...) reste ignoré par défaut.
lemegeton/**
!lemegeton/**/
!lemegeton/**/*.md
!lemegeton/**/*.txt
!lemegeton/**/*.py
!lemegeton/**/*.json
!lemegeton/**/*.csv
!lemegeton/**/*.html
!lemegeton/**/*.bat
!lemegeton/**/*.ps1
# Exceptions texte non publiées : conversation privée, sauvegardes locales.
lemegeton/ChatGPT-*.md
lemegeton/09_SAUVEGARDES/
lemegeton/**/__pycache__/

# Photos de reference du Terminatel 255 (annonce eBay) : droits du vendeur,
# usage local uniquement. Le README et l'inventaire CSV restent versionnes.
docs/Minitel Telic*/**/*.webp
docs/Minitel Telic*/**/*.png
docs/Minitel Telic*/**/*.jpg

# Archives Minitel/BBS de reference (481 Mo, executables DOS, textes de tiers) :
# consultation locale uniquement, jamais publiees.
docs/archive_minitel/

# Sources du monde explorable (docs/MONDE_EXPLORABLE.md) : modeles, textures,
# .blend et sons restent locaux. Seuls la provenance (SOURCES.csv) et les notes
# texte sont versionnees ; les GLB prepares vont dans public/models/.
monde/**
!monde/**/
!monde/**/*.md
!monde/**/*.csv
!monde/**/*.py
