# Servi sous https://sterenna.fr/minitel/ (OVH mutualisé, Apache).
AddType model/gltf-binary .glb
AddType application/wasm .wasm
AddType image/ktx2 .ktx2

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/javascript text/css model/gltf-binary application/wasm
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # JS et CSS sont fingerprintés par Vite : cache long sans risque.
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # Modeles et images versionnes (?v=empreinte, src/assets.ts), transcodeur
  # range par revision de three (basis/<revision>/) : cache long sans risque.
  ExpiresByType model/gltf-binary "access plus 1 year"
  ExpiresByType application/wasm "access plus 1 year"
  ExpiresByType image/ktx2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
