# Servi sous https://sterenna.fr/minitel/ (OVH mutualisé, Apache).
AddType model/gltf-binary .glb

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/javascript text/css model/gltf-binary
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # JS et CSS sont fingerprintés par Vite : cache long sans risque.
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType model/gltf-binary "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
